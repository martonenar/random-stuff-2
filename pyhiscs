import math
import time
print("projection time mile motion sim")
init_velocity = float(input("Enter the initial velocity (m/s): "))
angle = float(input("Enter the angle of launch (degrees): "))

print("logs")
vx = math.cos(math.radians(angle)) * init_velocity
vy = math.sin(math.radians(angle)) * init_velocity
time_elapsed = 0.0
x = 0.0
y = 0.0
max_height = 0
x_all_cords = []
y_all_cords = []

while True:
    x_all_cords.append(x)
    y_all_cords.append(y)
    print(f"Time: {time_elapsed:.4f} | X: {x:.4f} | Y: {y:.4f}")
    time.sleep(0.01)
    time_elapsed += 0.01
    x = vx * time_elapsed
    y = (vy * time_elapsed) - (0.5 * 9.8 * (time_elapsed ** 2))
    if y > max_height:
        max_height = y
    if y <= 0.0:
        print("Flight summary")
        print("total flight time: ", round(time_elapsed, 2))
        print("Max height: ", round(max_height, 2))
        print("total distance: ", round(x, 2))
        break
